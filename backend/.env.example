# Copy to .env for local development. Never commit a populated .env file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DB_ENGINE=sqlite

# The default local dev server uses SQLite. Managed hosting uses its injected DATABASE_URL.
# DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Real card and UPI checkout are available when Stripe test/live credentials are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
